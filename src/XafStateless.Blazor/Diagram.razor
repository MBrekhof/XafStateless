@using DevExpress.Blazor
@using XafStateless.Engine
@using Microsoft.JSInterop

<div class="xafstateless-diagram-root">
    @* XSM-023: zoom and orientation; the drawing itself is diagram.js's. *@
    <div class="xafstateless-diagram-toolbar" role="toolbar" aria-label="Diagram" style="display:flex;gap:4px;margin-bottom:6px;">
        <DxButton Text="−" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                  Attributes="@Labelled("Zoom out")" Click="@(() => Zoom(0.8))" />
        <DxButton Text="+" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                  Attributes="@Labelled("Zoom in")" Click="@(() => Zoom(1.25))" />
        <DxButton Text="Fit" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                  Attributes="@Labelled("Fit to width")" Click="@Fit" />
        <DxButton Text="@(landscape ? "Portrait" : "Landscape")" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                  Attributes="@Labelled(landscape ? "Show top to bottom" : "Show left to right")" Click="@ToggleOrientation" />
    </div>
    <div class="xafstateless-diagram" @ref="container" style="overflow:auto;"></div>
    @if (!string.IsNullOrEmpty(MermaidText))
    {
        @* XSM-028: the kind colors, the same styles WorkflowMermaid draws with. *@
        <div class="xafstateless-diagram-legend" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:6px;font-size:0.85em;">
            @foreach (var kind in Enum.GetValues<StateKind>())
            {
                var css = Css(WorkflowMermaid.StyleOf(kind));
                <span style="display:inline-flex;align-items:center;gap:4px;">
                    <span style="width:14px;height:14px;border-radius:3px;background:@css["fill"];border:2px solid @css["stroke"];"></span>@kind
                </span>
            }
            <span style="display:inline-flex;align-items:center;gap:4px;">
                <span style="width:14px;height:14px;border-radius:3px;background:#fde2e2;border:2px solid #c62828;"></span>Problem
            </span>
        </div>
    }
    @if (scriptsMissing)
    {
        <p class="xafstateless-diagram-missing">Diagram scripts are not loaded (mermaid.min.js, diagram.js): see docs/integrating.md.</p>
    }
    @if (Messages.Count > 0)
    {
        <ul class="xafstateless-diagram-messages" style="color:#b00020;">
            @foreach (var message in Messages)
            {
                <li>@message</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string MermaidText { get; set; } = "";
    [Parameter] public IReadOnlyList<string> Messages { get; set; } = [];
    [Inject] IJSRuntime JS { get; set; } = default!;

    ElementReference container;
    string rendered = "";
    string renderedDirection = "";
    bool landscape;
    bool scriptsMissing;

    string Direction => landscape ? "LR" : "TB";

    static Dictionary<string, string> Css(string style) =>
        style.Split(',').Select(p => p.Split(':')).ToDictionary(p => p[0], p => p[1]);

    static Dictionary<string, object> Labelled(string label) => new() { ["title"] = label, ["aria-label"] = label };

    // Re-renders only when the text or the orientation changed (Save/Publish re-fires this via a fresh Committed-triggered
    // value, but most re-renders of the surrounding page change neither).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (MermaidText == rendered && Direction == renderedDirection) return;
        (rendered, renderedDirection) = (MermaidText, Direction);
        await Call("diagram.render", container, MermaidText, Direction);
    }

    void ToggleOrientation() => landscape = !landscape;   // the next OnAfterRenderAsync redraws

    Task Zoom(double factor) => Call("diagram.zoom", container, factor);

    Task Fit() => Call("diagram.fit", container);

    async Task Call(string function, params object[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(function, args);
        }
        catch (JSException)   // the host page lacks the script tags: say so instead of breaking the circuit
        {
            if (!scriptsMissing) { scriptsMissing = true; StateHasChanged(); }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // circuit teardown: nothing to render into any more
        }
    }
}
