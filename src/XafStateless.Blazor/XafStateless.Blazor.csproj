<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>XAF Blazor module for XafStateless: string lookup editors and the workflow diagram (bundled Mermaid).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.ExpressApp.Blazor" Version="$(DevExpressPackageRange)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Model.DesignedDiffs.xafml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XafStateless.Module\XafStateless.Module.csproj" />
  </ItemGroup>

</Project>
