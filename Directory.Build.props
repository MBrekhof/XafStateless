<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The packages accept DevExpress 26.1.4 (what the demo and the first host pin) and any later 26.1 patch, and refuse
         26.2, whose assemblies must never be mixed with 26.1. Move it together with the demo's pinned version. -->
    <DevExpressPackageRange>[26.1.4,26.2)</DevExpressPackageRange>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Only Engine, Module and Blazor are packages; they set IsPackable. PackageVersion, not Version: the assembly
         versions stay as they are (XAF records each module's assembly version in the application database and refuses to
         start on a lower one). Bump PackageVersion for every push to the feed. -->
    <IsPackable>false</IsPackable>
    <PackageVersion>0.4.0</PackageVersion>
    <Authors>Martin Brekhof</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MBrekhof/XafStateless</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MBrekhof/XafStateless</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>xaf;devexpress;workflow;stateless;state-machine</PackageTags>
  </PropertyGroup>
</Project>
